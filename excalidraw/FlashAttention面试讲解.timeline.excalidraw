      "version": 1,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "依赖 Hopper 的 TMA、WGMMA、FP8 等能力，把搬运、矩阵乘、softmax 尽量重叠。",
      "fontSize": 15,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "依赖 Hopper 的 TMA、WGMMA、FP8 等能力，把搬运、矩阵乘、softmax 尽量重叠。",
      "autoResize": true,
      "lineHeight": 1.25
    },
