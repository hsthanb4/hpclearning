      "text": "Q5 v3 为什么和 Hopper 绑定？",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Q5 v3 为什么和 Hopper 绑定？",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "qa5-a",
      "type": "text",
      "x": 1293,
      "y": 634,
      "width": 474.3,
      "height": 18.75,
      "angle": 0,
      "strokeColor": "#374151",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
