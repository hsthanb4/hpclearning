      "lineHeight": 1.25
    },
    {
      "id": "qa3-a",
      "type": "text",
      "x": 1293,
      "y": 414,
      "width": 344.1,
      "height": 18.75,
      "angle": 0,
      "strokeColor": "#374151",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "seed": 1052,
      "version": 1,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "前向只存输出和每行统计量；反向重算局部分数和概率，避免保存完整注意力矩阵。",
      "fontSize": 15,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "前向只存输出和每行统计量；反向重算局部分数和概率，避免保存完整注意力矩阵。",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
