      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Q4 v2 相比 v1 本质提升是什么？",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Q4 v2 相比 v1 本质提升是什么？",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "qa4-a",
      "type": "text",
      "x": 1293,
      "y": 524,
      "width": 409.2,
      "height": 18.75,
      "angle": 0,
      "strokeColor": "#374151",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "seed": 1055,
      "version": 1,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "不是换数学公式，而是让 block、warp、head 的任务划分更适合 GPU 并行。",
      "fontSize": 15,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "不是换数学公式，而是让 block、warp、head 的任务划分更适合 GPU 并行。",
      "autoResize": true,
      "lineHeight": 1.25
    },
