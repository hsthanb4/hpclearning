      "seed": 1061,
      "version": 1,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Blackwell Tensor Core 更快，但 shared memory 和 exp 不是等比例更快，瓶颈转向 pipeline 和非 matmul。",
      "fontSize": 15,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Blackwell Tensor Core 更快，但 shared memory 和 exp 不是等比例更快，瓶颈转向 pipeline 和非 matmul。",
      "autoResize": true,
      "lineHeight": 1.25
    },
