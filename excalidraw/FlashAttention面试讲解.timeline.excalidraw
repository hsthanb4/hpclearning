      "text": "Q6 v4 为什么又要改？",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Q6 v4 为什么又要改？",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "qa6-a",
      "type": "text",
      "x": 1293,
      "y": 744,
      "width": 734.7,
      "height": 18.75,
      "angle": 0,
      "strokeColor": "#374151",
