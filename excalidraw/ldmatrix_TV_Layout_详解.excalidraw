      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "d0 = {A[0][0], A[0][1]}   ← Mat0\n       Row 0, Col 0-1\n\nd1 = {A[0][8], A[0][9]}   ← Mat1\n       Row 0, Col 8-9\n\nd2 = {A[8][0], A[8][1]}   ← Mat2\n       Row 8, Col 0-1\n\nd3 = {A[8][8], A[8][9]}   ← Mat3\n       Row 8, Col 8-9\n\n─────────────────────────\nThread 5 (t=5):\n  row=5/4=1, col_base=(5%4)*2=2\n  d0={A[1][2],A[1][3]}\n  d1={A[1][10],A[1][11]}\n  d2={A[9][2],A[9][3]}\n  d3={A[9][10],A[9][11]}",
      "fontSize": 13,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "d0 = {A[0][0], A[0][1]}   ← Mat0\n       Row 0, Col 0-1\n\nd1 = {A[0][8], A[0][9]}   ← Mat1\n       Row 0, Col 8-9\n\nd2 = {A[8][0], A[8][1]}   ← Mat2\n       Row 8, Col 0-1\n\nd3 = {A[8][8], A[8][9]}   ← Mat3\n       Row 8, Col 8-9\n\n─────────────────────────\nThread 5 (t=5):\n  row=5/4=1, col_base=(5%4)*2=2\n  d0={A[1][2],A[1][3]}\n  d1={A[1][10],A[1][11]}\n  d2={A[9][2],A[9][3]}\n  d3={A[9][10],A[9][11]}",
      "autoResize": false,
      "lineHeight": 1.25
    },

