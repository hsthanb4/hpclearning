      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Phase 2: AllGather (N-1 步, 每步将完整 chunk 传给下一个 GPU)",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": null,
      "originalText": "Phase 2: AllGather (N-1 步, 每步将完整 chunk 传给下一个 GPU)",
      "autoResize": false,
      "lineHeight": 1.25
    },
