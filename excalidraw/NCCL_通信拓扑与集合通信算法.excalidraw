      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "A* = a0+a1+a2+a3  B* = b0+b1+b2+b3  C* = c0+c1+c2+c3  D* = d0+d1+d2+d3",
      "fontSize": 12,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": null,
      "originalText": "A* = a0+a1+a2+a3  B* = b0+b1+b2+b3  C* = c0+c1+c2+c3  D* = d0+d1+d2+d3",
      "autoResize": false,
      "lineHeight": 1.25
    },
