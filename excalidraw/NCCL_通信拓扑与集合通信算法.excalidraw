      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "roundness": null,
      "seed": 1137,
      "version": 1,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "核心关系: 拓扑决定连接 → 连接决定 channel → channel 承载算法 → 算法决定通信效率",
      "fontSize": 13,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": null,
      "originalText": "核心关系: 拓扑决定连接 → 连接决定 channel → channel 承载算法 → 算法决定通信效率",
      "autoResize": false,
      "lineHeight": 1.25
    }
