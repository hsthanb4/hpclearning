      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "目标：数学和 v1 基本相同，把 GPU 利用率从 IO-aware 进一步推向接近 GEMM。",
      "fontSize": 17,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "目标：数学和 v1 基本相同，把 GPU 利用率从 IO-aware 进一步推向接近 GEMM。",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
