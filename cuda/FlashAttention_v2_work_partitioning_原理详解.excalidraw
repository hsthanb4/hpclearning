      "version": 1,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false
    },
    {
      "id": "pseudo-title",
      "type": "text",
      "x": 645,
      "y": 160,
      "width": 399.3000000000002,
      "height": 27.5,
      "angle": 0,
      "strokeColor": "#1e40af",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "seed": 8054,
      "version": 1,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "概念伪代码：更细的 query block 并行",
      "fontSize": 22,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "概念伪代码：更细的 query block 并行",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "pseudo-code",
      "type": "text",
      "x": 645,
      "y": 205,
      "width": 334.4000000000002,
      "height": 380,
      "angle": 0,
      "strokeColor": "#1e3a8a",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "seed": 8055,
      "version": 1,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "parallel for batch, head, q_block i:\n  split Qi rows across warps\n  keep K/V tile visible to all warps\n  m,l,acc are per Q-row slice\n\n  for k_block j:\n    load Kj,Vj once to SMEM\n    each warp handles its Q slice:\n      S_w = Q_w @ Kj.T\n      apply mask only when needed\n      online_softmax_update\n      acc_w += P_w @ Vj\n\n  no cross-warp reduction for O slice\n  store each warp output slice\n\nextra parallelism:\n  more CTAs cover sequence blocks\n  improves occupancy when B*H is small",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "parallel for batch, head, q_block i:\n  split Qi rows across warps\n  keep K/V tile visible to all warps\n  m,l,acc are per Q-row slice\n\n  for k_block j:\n    load Kj,Vj once to SMEM\n    each warp handles its Q slice:\n      S_w = Q_w @ Kj.T\n      apply mask only when needed\n      online_softmax_update\n      acc_w += P_w @ Vj\n\n  no cross-warp reduction for O slice\n  store each warp output slice\n\nextra parallelism:\n  more CTAs cover sequence blocks\n  improves occupancy when B*H is small",
      "autoResize": true,
      "lineHeight": 1.25
    },
