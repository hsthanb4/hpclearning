      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "概念伪代码：一个 CTA 处理一个 Q block",
      "fontSize": 22,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "概念伪代码：一个 CTA 处理一个 Q block",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "pseudo-code",
      "type": "text",
      "x": 635,
      "y": 205,
      "width": 299.20000000000016,
      "height": 380,
      "angle": 0,
      "strokeColor": "#14532d",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "seed": 8008,
      "version": 1,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "parallel for q_block i:\n  Qi = load Q[i] to SMEM/register\n  m = -inf; l = 0; acc = 0\n\n  for k_block j in 0..T:\n    Kj,Vj = load K[j],V[j] to SMEM\n    S = Qi @ Kj.T / sqrt(d)\n    if causal: S += mask(i,j)\n\n    m_new = max(m, rowmax(S))\n    alpha = exp(m - m_new)\n    P = exp(S - m_new)\n\n    acc = acc * alpha + P @ Vj\n    l = l * alpha + rowsum(P)\n    m = m_new\n\n  O[i] = acc / l\n  store O[i], m, l",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "parallel for q_block i:\n  Qi = load Q[i] to SMEM/register\n  m = -inf; l = 0; acc = 0\n\n  for k_block j in 0..T:\n    Kj,Vj = load K[j],V[j] to SMEM\n    S = Qi @ Kj.T / sqrt(d)\n    if causal: S += mask(i,j)\n\n    m_new = max(m, rowmax(S))\n    alpha = exp(m - m_new)\n    P = exp(S - m_new)\n\n    acc = acc * alpha + P @ Vj\n    l = l * alpha + rowsum(P)\n    m = m_new\n\n  O[i] = acc / l\n  store O[i], m, l",
      "autoResize": true,
      "lineHeight": 1.25
    },
