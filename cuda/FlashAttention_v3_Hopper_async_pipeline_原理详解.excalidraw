      "version": 1,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "概念伪代码：producer-consumer",
      "fontSize": 22,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "概念伪代码：producer-consumer",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "pseudo-code",
      "type": "text",
      "x": 645,
      "y": 205,
      "width": 325.6000000000002,
      "height": 400,
      "angle": 0,
      "strokeColor": "#1e3a8a",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "seed": 8089,
      "version": 1,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "producer warpgroup:\n  for k_block j:\n    TMA async load K[j],V[j]\n    write into circular SMEM stage\n    signal stage ready\n\nconsumer warpgroup A/B:\n  wait stage j ready\n  S_j = WGMMA(Q, K_j.T)\n  update rowmax and online softmax\n  O_partial = WGMMA(P_j, V_j)\n  ping-pong with other consumer\n\ninterleaving idea:\n  while A does softmax(j)\n  B can launch WGMMA(j+1)\n\nFP8 path:\n  block scale Q/K/V\n  incoherent processing reduces error",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "producer warpgroup:\n  for k_block j:\n    TMA async load K[j],V[j]\n    write into circular SMEM stage\n    signal stage ready\n\nconsumer warpgroup A/B:\n  wait stage j ready\n  S_j = WGMMA(Q, K_j.T)\n  update rowmax and online softmax\n  O_partial = WGMMA(P_j, V_j)\n  ping-pong with other consumer\n\ninterleaving idea:\n  while A does softmax(j)\n  B can launch WGMMA(j+1)\n\nFP8 path:\n  block scale Q/K/V\n  incoherent processing reduces error",
      "autoResize": true,
      "lineHeight": 1.25
    },
