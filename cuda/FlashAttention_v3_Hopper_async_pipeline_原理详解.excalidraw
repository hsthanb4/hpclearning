      "version": 1,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "关键讲法：v3 把原先串行的 load -> QK -> softmax -> PV，拆成异步阶段。softmax 不是 Tensor Core 任务，所以用另一个 warpgroup 的 GEMM 来遮住它。",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "关键讲法：v3 把原先串行的 load -> QK -> softmax -> PV，拆成异步阶段。softmax 不是 Tensor Core 任务，所以用另一个 warpgroup 的 GEMM 来遮住它。",
      "autoResize": true,
      "lineHeight": 1.25
    },
