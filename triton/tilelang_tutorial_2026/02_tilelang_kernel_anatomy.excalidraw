      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": null,
      "originalText": "def kernel(M, N, K, dtype):\n    @T.prim_func\n    def main(A, B, C):\n        with T.Kernel(grid, threads):",
      "autoResize": false,
      "lineHeight": 1.25
    },
